    {
      "date": "2026-12-31",
      "platform": "游戏",
      "images": {
        "small": "https://lain.bgm.tv/r/200/pic/cover/l/9b/6a/681276_RoJZr.jpg",
        "grid": "https://lain.bgm.tv/r/100/pic/cover/l/9b/6a/681276_RoJZr.jpg",
        "large": "https://lain.bgm.tv/pic/cover/l/9b/6a/681276_RoJZr.jpg",
        "medium": "https://lain.bgm.tv/r/800/pic/cover/l/9b/6a/681276_RoJZr.jpg",
